{
  "name": "control-prestamos",
  "version": "0.1.0",
  "private": true,
  "description": "Control de préstamos con modo sencillo y modo propietario",
  "type": "module",
  "scripts": {
    "dev": "http-server . -p 4173 -c-1",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test tests/e2e/app.spec.js",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js",
    "test:responsive": "playwright test tests/e2e/responsive.spec.js",
    "quality": "npm test && npm run test:e2e && npm run test:a11y && npm run test:responsive",
    "report": "node scripts/write-quality-report.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "http-server": "^14.1.1"
  }
}
